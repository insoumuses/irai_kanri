// create messages
// function called from the client side (see clientScript)
function getTenkaiParams () {
  console.warn('LOADING TENKAI PARAMS');
  console.time('Loading message');

  let botKun = BotKun.summon(magicIncantation)
  botKun.loadProject()

  let parameters = botKun.pj.tenkai.makeTenkaiParams(3)

  // CW_ID → 呼び方 のマップを作成
  const nicknameMap = {}
  botKun.cw.members.stored.forEach(member => {
    if (member.CW_ID && member['呼び方']) {
      nicknameMap[String(member.CW_ID)] = member['呼び方']
    }
  })

  if (parameters.tasks && Array.isArray(parameters.tasks)) {
    parameters.tasks.forEach(task => {
      if (task.message) {
        const lines = task.message.split('\n')

        let prevLang = null
        const langGroups = []
        let currentGroup = []
        let bodyStartIndex = 0

        for (let i = 0; i < lines.length; i++) {
          const line = lines[i]

          if (!line.startsWith('[To:')) {
            bodyStartIndex = i
            break
          }

          const match = line.match(/^\[To:(\d+)\].*?_(EN|ES|DE|FR|TC|KR|IT|SC|PT)/)
          if (!match) continue

          const [, id, lang] = match
          const nickname = nicknameMap[id] || ''

          if (prevLang !== null && lang !== prevLang) {
            if (currentGroup.length > 0) {
              langGroups.push(currentGroup.join(' '))
              currentGroup = []
            }
          }

          currentGroup.push(`[To:${id}]${nickname}`)
          prevLang = lang
        }

        if (currentGroup.length > 0) {
          langGroups.push(currentGroup.join(' '))
        }

        const body = lines.slice(bodyStartIndex).join('\n')
        task.message = langGroups.join('\n') + '\n' + body
      }
    })
  }

  console.log(parameters)

  console.timeEnd('Loading message')
  return JSON.stringify(parameters)
}
