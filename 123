// create messages
// function called from the client side (see clientScript)
function getTenkaiParams () {
  console.warn('LOADING TENKAI PARAMS');
  console.time('Loading message');

  let botKun = BotKun.summon(magicIncantation)
  botKun.loadProject()

  let parameters = botKun.pj.tenkai.makeTenkaiParams(3)

  if (parameters.tasks && Array.isArray(parameters.tasks)) {
    parameters.tasks.forEach(task => {
      if (task.message) {
        task.message = task.message
        .replace(/^/, ' ')
        .replace(/WO.*?(?=_(?:EN|ES|DE|FR|TC|KR|IT|SC|PT)|お疲れ様です|$)/g, '')//WO ~ _XX or お疲れ様です
        .replace(/(_(?:EN|ES|DE|FR|TC|KR|IT|SC|PT)+)[\s\S]*?(?=\[To:)/g, '$1')//_XX ~ [To:
        .replace(/(\[To:[^\]]+\]_(\w+))(?=\[To:[^\]]+\]_(\w+))/g,
                 (match, first, lang1, lang2) => lang1 !== lang2 ? first + '/' : first
                )//_xx連続しない場合、/
        .replace(/_(?:EN|ES|DE|FR|TC|KR|IT|SC|PT)+/g, '')
        .replace(/お疲れ様です/g, '\nお疲れ様です')
                        }
    })
  }

  console.log(parameters)

  console.timeEnd('Loading message')
  return JSON.stringify(parameters)
}
